{
  "name": "markdown-quote",
  "displayName": "Markdown Quote",
  "description": "把选中的文本一键转成 Markdown 引用，可选标注为 AI 回答",
  "version": "0.0.1",
  "publisher": "kkkwang",
  "license": "MIT",
  "homepage": "https://github.com/wkstudy/markdown-quote-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wkstudy/markdown-quote-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/wkstudy/markdown-quote-vscode/issues"
  },
  "keywords": [
    "markdown",
    "quote",
    "blockquote",
    "引用",
    "ai"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:markdownQuote.convert",
    "onCommand:markdownQuote.convertAi"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownQuote.convert",
        "title": "转为引用"
      },
      {
        "command": "markdownQuote.convertAi",
        "title": "转为 AI 引用"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownQuote.convert",
          "when": "editorHasSelection",
          "group": "1_modification"
        },
        {
          "command": "markdownQuote.convertAi",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownQuote.convert",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "editorHasSelection"
      },
      {
        "command": "markdownQuote.convertAi",
        "key": "ctrl+alt+shift+q",
        "mac": "cmd+alt+shift+q",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Markdown Quote",
      "properties": {
        "markdownQuote.label": {
          "type": "string",
          "default": "🤖 AI 回答",
          "description": "AI 引用的标注文案"
        },
        "markdownQuote.style": {
          "type": "string",
          "enum": [
            "bold",
            "alert"
          ],
          "default": "bold",
          "description": "bold = 加粗标注行；alert = GitHub [!NOTE] 提示块"
        }
      }
    }
  }
}
